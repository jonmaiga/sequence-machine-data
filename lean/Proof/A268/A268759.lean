import Prog.A268.A2687
import Proof.Lib.Integral

/-- A268759: Triangle T(n,k) read by rows: T(n,k) = (1/4)*(1 + k)*(2 + k)*(k - n)*(1 + k - n). The name formula is an integer. -/
theorem A268759.anchor (n : ℕ) :
    (A268759 n : ℚ) = (1 : ℚ) / 4 * (1 + SequenceMachineLib.triCol n : ℚ) * (2 + SequenceMachineLib.triCol n : ℚ) * ((SequenceMachineLib.triCol n : ℤ) - (SequenceMachineLib.triRow n : ℤ) : ℚ) * ((1 + SequenceMachineLib.triCol n : ℤ) - (SequenceMachineLib.triRow n : ℤ) : ℚ) := by
  have hE : (1 : ℚ) / 4 * (1 + SequenceMachineLib.triCol n : ℚ) * (2 + SequenceMachineLib.triCol n : ℚ) * ((SequenceMachineLib.triCol n : ℤ) - (SequenceMachineLib.triRow n : ℤ) : ℚ) * ((1 + SequenceMachineLib.triCol n : ℤ) - (SequenceMachineLib.triRow n : ℤ) : ℚ) = ((2 * (SequenceMachineLib.triCol n : ℤ) + 5 * (SequenceMachineLib.triCol n : ℤ) ^ 2 + 4 * (SequenceMachineLib.triCol n : ℤ) ^ 3 + (SequenceMachineLib.triCol n : ℤ) ^ 4 - 2 * (SequenceMachineLib.triRow n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 2 - 2 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 3 + 2 * (SequenceMachineLib.triRow n : ℤ) ^ 2 + 3 * (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) + (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) ^ 2 : ℤ) : ℚ) / 4 := by push_cast; ring
  have h4 : (4 : ℤ) ∣ 2 * (SequenceMachineLib.triCol n : ℤ) + 5 * (SequenceMachineLib.triCol n : ℤ) ^ 2 + 4 * (SequenceMachineLib.triCol n : ℤ) ^ 3 + (SequenceMachineLib.triCol n : ℤ) ^ 4 - 2 * (SequenceMachineLib.triRow n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 2 - 2 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 3 + 2 * (SequenceMachineLib.triRow n : ℤ) ^ 2 + 3 * (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) + (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) ^ 2 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 4).mp (by
      push_cast
      generalize (SequenceMachineLib.triRow n : ZMod 4) = x
      generalize (SequenceMachineLib.triCol n : ZMod 4) = y
      revert x y
      decide)
  obtain ⟨z, hz⟩ : (4 : ℤ) ∣ 2 * (SequenceMachineLib.triCol n : ℤ) + 5 * (SequenceMachineLib.triCol n : ℤ) ^ 2 + 4 * (SequenceMachineLib.triCol n : ℤ) ^ 3 + (SequenceMachineLib.triCol n : ℤ) ^ 4 - 2 * (SequenceMachineLib.triRow n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 2 - 2 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 3 + 2 * (SequenceMachineLib.triRow n : ℤ) ^ 2 + 3 * (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) + (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) ^ 2 := by omega
  have hq : (1 : ℚ) / 4 * (1 + SequenceMachineLib.triCol n : ℚ) * (2 + SequenceMachineLib.triCol n : ℚ) * ((SequenceMachineLib.triCol n : ℤ) - (SequenceMachineLib.triRow n : ℤ) : ℚ) * ((1 + SequenceMachineLib.triCol n : ℤ) - (SequenceMachineLib.triRow n : ℤ) : ℚ) = (z : ℚ) := by
    rw [hE, div_eq_iff (by norm_num)]
    exact_mod_cast (by rw [hz]; ring : 2 * (SequenceMachineLib.triCol n : ℤ) + 5 * (SequenceMachineLib.triCol n : ℤ) ^ 2 + 4 * (SequenceMachineLib.triCol n : ℤ) ^ 3 + (SequenceMachineLib.triCol n : ℤ) ^ 4 - 2 * (SequenceMachineLib.triRow n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) - 7 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 2 - 2 * (SequenceMachineLib.triRow n : ℤ) * (SequenceMachineLib.triCol n : ℤ) ^ 3 + 2 * (SequenceMachineLib.triRow n : ℤ) ^ 2 + 3 * (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) + (SequenceMachineLib.triRow n : ℤ) ^ 2 * (SequenceMachineLib.triCol n : ℤ) ^ 2 = z * 4)
  simp only [A268759, A268759.P11190224258568772249.a, SequenceMachineLib.memo_apply, hq, SequenceProof.roundAway_intCast]
