-/

namespace A027964.P4648428431722420487
noncomputable section

def f4 : ℕ → ℕ := SequenceMachineLib.rec [1, 3] fun n f4 =>
  f4 (n - 1) + f4 (n - 2)

def f3 : ℕ → ℕ := SequenceMachineLib.memo fun n =>
  ∑ j ∈ Finset.range (n + 1), f4 j

